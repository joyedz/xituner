# --- base model ---
# Base model is a CONFIG PARAMETER, never a hardcoded constant.
# Default is Gemma; Gemma is also the only demoed path (see Requirements section 7).
BASE_MODEL=google/gemma-3-270m

# GEMMA IS A GATED REPO. Without a token the load fails with HTTP 401, so this
# is a hard prerequisite, not a nicety. One-time setup:
#   1. Accept the license at https://huggingface.co/google/gemma-3-270m
#   2. Create a READ token at https://huggingface.co/settings/tokens
#   3. Put it below
# Judges reproducing the project need this too -- it goes in the README.
HF_TOKEN=

# Ungated stand-in used to validate the pipeline without waiting on gate
# approval. Not for the demo: demoing a non-Gemma model forfeits the +0.2
# Google-model bonus.
#   BASE_MODEL=HuggingFaceTB/SmolLM2-135M-Instruct

# --- Gemini (decision layer) ---
# Free tier key from https://aistudio.google.com
# Not needed for the kill-risk gate.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Comma-separated fallback chain, tried in order. Two reasons it is a chain and
# not a single name, both measured on 2026-08-14:
#
#   1. Free-tier models return 503 "high demand" fairly often. gemini-3.5-flash
#      was overloaded while 3.7-flash answered fine, and minutes earlier the
#      reverse was true. The client retries with backoff, then moves on, so a
#      busy endpoint costs seconds instead of the run.
#
#   2. The free tier caps requests per DAY per MODEL (20). A full loop run makes
#      4+ calls, so a day of iteration exhausts one model. Each model has its own
#      budget, so a four-model chain is four budgets. With a single fallback, the
#      run died mid-diagnosis with 429 RESOURCE_EXHAUSTED.
#
# Every entry must be 3.5 or newer to satisfy the contest requirement.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# --- Google Cloud (not needed for the kill-risk gate) ---
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=

# --- training ---
# Force CPU even if a GPU is present, for reproducing the primary path.
XITUNER_FORCE_CPU=1
